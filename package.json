{
  "name": "culprit",
  "version": "0.2.0",
  "description": "Finds the commit that broke a browser flow by replaying a recorded Kane CLI test across git history, then closes the loop: an agent patches it and Kane re-verifies.",
  "type": "module",
  "bin": {"culprit": "bin/culprit.mjs"},
  "files": ["bin", "lib", "demo/seed.mjs", "README.md"],
  "keywords": ["kane-cli", "git-bisect", "regression", "ai-agent", "browser-testing"],
  "repository": {"type": "git", "url": "git+https://github.com/BenCoy09/culprit.git"},
  "homepage": "https://github.com/BenCoy09/culprit",
  "scripts": {
    "seed": "node demo/seed.mjs demo/repo",
    "start": "node web.mjs",
    "test": "node --test test/culprit.test.mjs test/web.test.mjs"
  },
  "engines": {"node": ">=18"}
}
